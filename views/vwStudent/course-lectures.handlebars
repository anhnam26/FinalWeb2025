<h2 class="my-4">
  <i class="bi bi-collection-play"></i> Danh sách bài học
</h2>

{{#if lectures.length}}
  <div class="table-responsive">
    <table class="table align-middle">
      <thead class="table-light">
        <tr>
          <th style="width:90px;">#</th>
          <th>Tên bài học</th>
          <th style="width:140px;">Thời lượng</th>
          <th style="width:140px;"></th>
        </tr>
      </thead>
      <tbody>
        {{#each lectures as |lec|}}
        <tr>
          <td class="text-muted">{{lec.ord}}</td>
          <td>{{lec.title}}</td>
          <td>{{formatDuration lec.duration_sec}}</td>
          <td class="text-end">
            <a class="btn btn-outline-primary btn-sm"
               href="/student/courses/{{../courseId}}/{{lec.id}}">
              <i class="bi bi-play-circle"></i> Vào học
            </a>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
{{else}}
  <div class="text-muted">Khóa học chưa có bài giảng.</div>
{{/if}}

<a href="/student/courses" class="btn btn-link mt-3"><i class="bi bi-arrow-left"></i> Quay lại</a>
