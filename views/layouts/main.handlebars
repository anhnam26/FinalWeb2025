<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Online Academy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/static/style.css">


</head>

<body>
  <header class="bg-light border-bottom py-2 px-4 d-flex align-items-center justify-content-between">
    <div class="d-flex align-items-center">
      <img src="/static/imgs/logo.png" alt="Logo" height="70" class="me-5">
      <form class="d-flex" role="search" style="margin-left: 160px; width: 700px; height: 50px;">
        <input class="form-control me-1 flex-grow-1" type="search" placeholder="Enter course name" aria-label="Search">
        <button class="btn btn-primary d-flex align-items-center justify-content-center"
          style="width: 80px; height: 50px;"><i class="bi bi-search"></i>
        </button>

      </form>
    </div>
    <div>
      {{#if isAuthenticated}}
      <span class="me-3">👋 Chào mừng, <strong>{{authUser.name}}</strong></span>
      <form action="/account/signout" method="post" class="d-inline">
        <button type="submit" class="btn btn-outline-danger">
          <i class="bi bi-box-arrow-right"></i> Sign Out
        </button>
      </form>
      {{else}}
      <a class="nav-link d-inline-block me-2" href="/account/signup">
        <i class="bi bi-person-plus"></i> Sign Up
      </a>
      <a class="nav-link d-inline-block" href="/account/signin">
        <i class="bi bi-box-arrow-in-right"></i> Sign In
      </a>
      {{/if}}
    </div>
  </header>


  <main class="container-fluid mt-3">
    {{{body}}}
  </main>

  <footer class="text-center mt-4 p-3 bg-light border-top">
    <small>...</small>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  {{{_sections.js}}}
</body>

</html>