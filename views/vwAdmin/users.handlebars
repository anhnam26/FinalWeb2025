<h2 class="text-center mt-4 mb-4">Quản lý Người dùng</h2>

<div class="container">
  <table class="table table-striped table-bordered">
    <thead class="table-dark">
      <tr>
        <th>#</th>
        <th>Họ và tên</th>
        <th>Email</th>
        <th>Quyền</th>
        <th>Trạng thái</th>
        <th>Hành động</th>
      </tr>
    </thead>
    <tbody>
      {{#each users}}
      <tr>
        <td>{{@index}}</td>
        <td>{{fullname}}</td>
        <td>{{email}}</td>
        <td>
          {{#if isTeacher}}
            <span class="badge bg-primary">Giảng viên</span>
          {{else}}
            <span class="badge bg-secondary">Học viên</span>
          {{/if}}
        </td>
        <td>
          {{#if isLocked}}
            <span class="badge bg-danger">Bị khóa</span>
          {{else}}
            <span class="badge bg-success">Hoạt động</span>
          {{/if}}
        </td>
        <td>
          {{#unless isTeacher}}
            <form action="/admin/user/make-teacher/{{id}}" method="POST" style="display:inline;">
              <button type="submit" class="btn btn-sm btn-primary">Cấp quyền Giảng viên</button>
            </form>
          {{/unless}}

          {{#if isLocked}}
            <form action="/admin/user/unlock/{{id}}" method="POST" style="display:inline;">
              <button type="submit" class="btn btn-sm btn-success">Mở khóa</button>
            </form>
          {{else}}
            <form action="/admin/user/lock/{{id}}" method="POST" style="display:inline;">
              <button type="submit" class="btn btn-sm btn-warning">Khóa</button>
            </form>
          {{/if}}

          <form action="/admin/user/delete/{{id}}" method="POST" style="display:inline;" onsubmit="return confirm('Bạn có chắc muốn xóa người dùng này?');">
            <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
          </form>
        </td>
      </tr>
      {{else}}
      <tr>
        <td colspan="6" class="text-center text-muted">Không có người dùng nào.</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
